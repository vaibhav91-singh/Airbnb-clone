<% layout("/boilerplate") %>
<link rel="stylesheet" href="/Home.css">

<section class="home">
    <div class="home-bg" aria-hidden="true">
        <span class="blob blob--gold"></span>
        <span class="blob blob--coral"></span>
        <span class="blob blob--teal"></span>
        <span class="grid"></span>
    </div>

    <div class="home-hero">
        <div class="hero-left">
            <p class="kicker">WonderLush • Travel stays & experiences</p>
            <h1 class="hero-title">
                Find your next
                <span class="hero-title__accent">dream stay</span>
            </h1>
            <p class="hero-subtitle">
                Beautiful listings, smooth browsing, and a modern experience.
                Explore villas, cabins, and city apartments—crafted for wanderlust.
            </p>

            <div class="hero-actions">
                <a class="btn3d btn3d--primary" href="/listings">Explore Listings</a>
                <a class="btn3d btn3d--ghost" href="/listings/new">Add a Listing</a>
            </div>

            <div class="hero-stats" aria-label="Site highlights">
                <div class="stat">
                    <div class="stat__num">50+</div>
                    <div class="stat__label">Curated stays</div>
                </div>
                <div class="stat">
                    <div class="stat__num">4.8★</div>
                    <div class="stat__label">Avg. rating</div>
                </div>
                <div class="stat">
                    <div class="stat__num">24/7</div>
                    <div class="stat__label">Support</div>
                </div>
            </div>
        </div>

        <div class="hero-right" aria-hidden="true">
            <div class="stack">
                <div class="card3d card3d--a">
                    <div class="card3d__topline"></div>
                    <div class="card3d__content">
                        <div class="card3d__badge">Featured</div>
                        <div class="card3d__title">Beach Villa</div>
                        <div class="card3d__meta">Goa • India</div>
                    </div>
                </div>

                <div class="card3d card3d--b">
                    <div class="card3d__topline"></div>
                    <div class="card3d__content">
                        <div class="card3d__badge">Trending</div>
                        <div class="card3d__title">Mountain Cabin</div>
                        <div class="card3d__meta">Manali • India</div>
                    </div>
                </div>

                <div class="card3d card3d--c">
                    <div class="card3d__topline"></div>
                    <div class="card3d__content">
                        <div class="card3d__badge">New</div>
                        <div class="card3d__title">City Loft</div>
                        <div class="card3d__meta">Mumbai • India</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="home-features">
        <h2 class="section-title">Why WonderLush?</h2>
        <div class="feature-grid">
            <article class="feature">
                <div class="feature__icon">✦</div>
                <h3 class="feature__title">Flexible Travel</h3>
                <p class="feature__text">Make Your Travel Easy And Smooth Like Butter.</p>
            </article>
            <article class="feature">
                <div class="feature__icon">⟡</div>
                <h3 class="feature__title">Service</h3>
                <p class="feature__text">Beautiful listings, Beautiful Rooms, and a modern experience.</p>
            </article>
            <article class="feature">
                <div class="feature__icon">⬡</div>
                <h3 class="feature__title">Shareable</h3>
                <p class="feature__text">Open any listing and share the link with friends.</p>
            </article>
        </div>
    </div>
</section>
